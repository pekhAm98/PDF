{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "sourceMap": true
  },

  "include": ["src/server.ts", "src/**/*.ts", "src/**/*.mts", "src/**/*.cts"],
  "exclude": ["node_modules", "dist"]
}
